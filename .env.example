SPRING_PROFILES_ACTIVE=prod
POSTGRES_DB=gymapp
POSTGRES_USER=gymapp
POSTGRES_PASSWORD=replace_with_local_password
# Estas tres variables se usan al ejecutar la API fuera de Compose.
DB_URL=jdbc:postgresql://localhost:5432/gymapp
DB_USERNAME=gymapp
DB_PASSWORD=replace_with_local_password
JWT_SECRET=replace_with_base64_key_of_at_least_32_random_bytes
JWT_EXPIRATION_MS=3600000
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
